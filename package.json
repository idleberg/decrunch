{
	"name": "decrunch",
	"version": "0.0.0",
	"description": "An obstrusive loading indicator for the terminal, reminiscent of Commodore 64's \"decrunching\"",
	"license": "MIT",
	"author": "Jan T. Sott",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/idleberg/decrunch.git"
	},
	"keywords": [
		"terminal",
		"tui",
		"cli",
		"loading indicator",
		"spinner"
	],
	"type": "module",
	"bin": {
		"decrunch": "./lib/cli.mjs"
	},
	"exports": {
		".": {
			"types": "./lib/decrunch.d.mts",
			"import": "./lib/decrunch.mjs"
		}
	},
	"engines": {
		"node": ">=20"
	},
	"files": [
		"lib/",
		"LICENSE",
		"README.md"
	],
	"scripts": {
		"build": "tsdown",
		"dev": "tsdown --watch",
		"lint": "concurrently --prefix-colors blue,magenta npm:lint:*",
		"lint:biome": "biome check",
		"lint:e18e": "e18e-cli analyze",
		"prepack": "npm run lint && npm run build",
		"prepare": "lefthook install",
		"publish:jsr": "deno publish",
		"publish:npm": "np --any-branch",
		"test": "vitest run"
	},
	"dependencies": {
		"commander": "^14.0.2",
		"kleur": "^4.1.5",
		"log-symbols": "^7.0.1"
	},
	"devDependencies": {
		"@commitlint/cli": "^20.1.0",
		"@commitlint/config-conventional": "^20.0.0",
		"@e18e/cli": "^0.3.1",
		"@idleberg/configs": "^0.3.3",
		"@types/node": "^24.10.0",
		"@vitest/coverage-v8": "^4.0.8",
		"concurrently": "^9.2.1",
		"np": "^10.2.0",
		"tsdown": "^0.16.1",
		"typescript": "^5.9.3",
		"vitest": "^4.0.8"
	},
	"packageManager": "pnpm@10.21.0+sha512.da3337267e400fdd3d479a6c68079ac6db01d8ca4f67572083e722775a796788a7a9956613749e000fac20d424b594f7a791a5f4e2e13581c5ef947f26968a40"
}
